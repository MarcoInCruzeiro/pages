{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quiz-socio.vercel.app/config/ga4/ga4.schema.json",
  "title": "Configuração GA4",
  "description": "Configuração de medição GA4 extraída do index.html",
  "type": "object",
  "required": [
    "propriedade",
    "ambientesHabilitados",
    "eventos",
    "isolamento"
  ],
  "properties": {
    "descricao": {
      "type": "string"
    },
    "versao": {
      "type": "string"
    },
    "propriedade": {
      "type": "object",
      "required": [
        "measurementId"
      ],
      "properties": {
        "measurementId": {
          "type": "string",
          "pattern": "^G-[A-Z0-9]+$"
        },
        "nome": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ambientesHabilitados": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "hostname"
      },
      "uniqueItems": true
    },
    "eventos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "nome",
          "quando",
          "camposPrincipais",
          "interpretacao",
          "chave",
          "tipos"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$"
          },
          "quando": {
            "type": "string"
          },
          "camposPrincipais": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "interpretacao": {
            "type": "string"
          },
          "chave": {
            "type": "string",
            "enum": [
              "quiz_start",
              "quiz_answer",
              "quiz_complete",
              "quiz_subscribe_click"
            ]
          },
          "tipos": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": [
                "string",
                "number",
                "boolean",
                "number|null"
              ]
            }
          }
        },
        "additionalProperties": false
      },
      "minItems": 4,
      "maxItems": 4
    },
    "isolamento": {
      "type": "object",
      "properties": {
        "camada1": {
          "type": "string"
        },
        "camada2": {
          "type": "string"
        },
        "ambientesExcluidos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nota": {
          "type": "string"
        }
      },
      "required": [
        "camada1",
        "camada2",
        "ambientesExcluidos",
        "nota"
      ],
      "additionalProperties": false
    },
    "limiteParametrosPersonalizados": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "observacao": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
